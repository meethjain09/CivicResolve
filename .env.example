# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Chief Admin (Head) Credentials (Optional - defaults to head@civicresolve.gov / HeadAdmin@2026)
HEAD_ADMIN_EMAIL=head@civicresolve.gov
HEAD_ADMIN_PASSWORD=HeadAdmin@2026

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated model priority chain (if empty, dynamically discovers available models via ai.models.list())
GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
